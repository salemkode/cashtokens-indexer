{
  "name": "blaze-cashtokens-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "storage-report": "tsx scripts/storage-report.ts",
    "storage-report:built": "node dist/scripts/storage-report.js",
    "contracts:export": "tsx scripts/export-contracts.ts",
    "test:built": "npm run build && BLAZE_TEST_BUILT=true tsx --test test/main.test.ts",
    "db:backup": "node dist/scripts/database.js --action backup",
    "db:restore": "node dist/scripts/database.js --action restore",
    "db:check": "node dist/scripts/database.js --action check",
    "db:unlock": "node dist/scripts/database.js --action unlock",
    "test:regtest": "tsx --test test/regtest.test.ts",
    "serve:regtest": "npm run build && tsx test/serve-regtest.ts",
    "check:clean": "tsx scripts/clean-install.ts",
    "accept:chipnet": "node --env-file-if-exists=.env dist/scripts/chipnet-acceptance.js",
    "accept:server": "node --env-file-if-exists=.env dist/scripts/server-acceptance.js",
    "test:server-ops": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s test -p test_server_ops.py -v",
    "test:node-supervisor": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s test -p 'test_owned_node.py' -v"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "effect": "^3.0.0",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}

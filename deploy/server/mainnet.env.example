# Server-local BCHN. Its RPC listener must remain private.
BCH_RPC_URL=http://127.0.0.1:8332
BCH_RPC_USER=blaze-mainnet
BCH_RPC_PASSWORD='replace-with-mainnet-rpc-password'
# Complete token and metadata history. Do not reuse a partial-scan database.
START_HEIGHT=0
SERVE_BCH_API=true
# Requires an archival, synchronized txindex source for unrestricted BCH pages.
# To use a separate source, set its URL and independent credentials here:
# BCH_HISTORY_RPC_URL=http://private-mainnet-archive:8332
# BCH_HISTORY_RPC_USER=blaze-mainnet-history
# BCH_HISTORY_RPC_PASSWORD='replace-with-history-rpc-password'
CORS_ORIGINS=https://explorer.example.com
UNDO_DEPTH=288
SYNC_BATCH_SIZE=100
POLL_INTERVAL_MS=5000
RPC_TIMEOUT_MS=30000
RPC_MAX_RESPONSE_BYTES=67108864
MAX_SYNC_AGE_MS=30000
# Ingestion safety floor, not a whole-server hard quota.
MIN_FREE_BYTES=90000000000

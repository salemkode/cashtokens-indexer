# Replace these with absolute paths on the intended server disks.
# Directories must already exist; Compose will not silently create them.
BLAZE_DATA_ROOT=/srv/blaze-data
BLAZE_BACKUP_ROOT=/srv/blaze-backups
# Works directly from a fresh GitHub clone; compilation happens inside Docker.
# For a verified handoff that includes dist/, use Dockerfile.runtime instead.
BLAZE_DOCKERFILE=Dockerfile
# Starting profile: 6 CPU cores, 16 GB RAM, roughly 900 GB disk capacity.
# Limits apply to EACH indexer, not the entire server or its BCHN processes.
BLAZE_INDEXER_MEMORY_LIMIT=2g
BLAZE_NODE_HEAP_MIB=1024
BLAZE_INDEXER_CPUS=2
# 90 GB ingestion floor for a roughly 900 GB disk; refine from actual filesystem.
BLAZE_MIN_FREE_BYTES=90000000000

# Server-local BCHN with verified current Chipnet consensus support.
BCH_RPC_URL=http://127.0.0.1:48332
BCH_RPC_USER=blaze-chipnet
BCH_RPC_PASSWORD='replace-with-chipnet-rpc-password'
# Complete token and metadata history. Do not reuse a partial-scan database.
START_HEIGHT=0
SERVE_BCH_API=true
# Optional separate same-network archive with independent credentials:
# BCH_HISTORY_RPC_URL=http://private-chipnet-archive:48332
# BCH_HISTORY_RPC_USER=blaze-chipnet-history
# BCH_HISTORY_RPC_PASSWORD='replace-with-history-rpc-password'
CORS_ORIGINS=https://chipnet-explorer.example.com
UNDO_DEPTH=288
SYNC_BATCH_SIZE=100
POLL_INTERVAL_MS=5000
RPC_TIMEOUT_MS=30000
RPC_MAX_RESPONSE_BYTES=67108864
MAX_SYNC_AGE_MS=30000
MIN_FREE_BYTES=90000000000

NETWORK=chipnet
BCH_RPC_URL=http://127.0.0.1:48332
BCH_RPC_USER=blaze
BCH_RPC_PASSWORD=replace-with-your-local-node-rpc-password
# Alternatively use BCH_RPC_COOKIE_FILE=/absolute/path/to/.bitcoin/.cookie
# Cookie authentication takes precedence over username/password.
# false exposes token routes only; extraction itself does not require txindex.
SERVE_BCH_API=true
# Optional separate archival node for historical BCH explorer pages.
# Without this URL, enabled BCH pages use BCH_RPC_URL as before.
# History credentials are independent and never inherited from extraction RPC.
# BCH_HISTORY_RPC_URL=http://your-archive-node:8332
# BCH_HISTORY_RPC_USER=explorer
# BCH_HISTORY_RPC_PASSWORD=replace-with-archive-node-password
# BCH_HISTORY_RPC_COOKIE_FILE=/absolute/path/to/archive-node/.cookie
DATABASE_PATH=./data/cashtokens.sqlite
# 0 is the safe, complete default. For faster mainnet scans see README.
START_HEIGHT=0
HOST=127.0.0.1
PORT=3001
SYNC_BATCH_SIZE=100
POLL_INTERVAL_MS=5000
RPC_TIMEOUT_MS=30000
CORS_ORIGINS=https://explorer.salemkode.com,http://localhost:3000
# Optional extra chain identity check (also persisted on first successful connection):
# EXPECTED_GENESIS_HASH=000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f
# Spent/unspendable token output retention for atomic reorg rollback.
# Deeper reorgs stop and require a fresh rescan; increasing this cannot restore pruned undo.
UNDO_DEPTH=288

# Chipnet uses its own fork checkpoint; a bchtest address prefix is insufficient.
# 121957 is first CashTokens block on Chipnet. Earlier metadata history remains incomplete.
# Optional publication-free identities to follow; configure before a fresh rescan.
AUTHCHAIN_BASES=
MAX_SYNC_AGE_MS=30000
MIN_FREE_BYTES=536870912

# Optional host-only server-to-server read proxy; never put upstream credentials in browser config.
# RPC_PROXY_PORT=3002
RPC_MAX_RESPONSE_BYTES=67108864
# Approved test submission service is disabled unless all three are provided.
# Use a separate upstream credential and a private mode-0600 policy. Never mainnet.
# BCH_TEST_RPC_URL=http://your-chipnet-node:48332
# BCH_TEST_RPC_COOKIE_FILE=/private/path/to/test-node.cookie
# TEST_RPC_PORT=3003
# TEST_APPROVAL_FILE=/private/path/to/approved-test-transactions.json

+<script setup lang="ts">
+import { z } from "zod";
+import { formatLockingBytecodeAddress } from "~/hooks/addressDisplay";
+import { useCashTokensQuery } from "~/hooks/cashTokens";
+import { exactTokenAmount, tokenHistory, tokenHolders, tokenOutputs, tokenSummary } from "~/module/cashTokens";
+import { useRegistryStore, useStateStore } from "~/store";
+
+const route = useRoute();
+const category = z.string().regex(/^[0-9a-fA-F]{64}$/).parse(route.params.category).toLowerCase();
+const state = useStateStore();
+const registry = useRegistryStore();
+const pageSize = 8;
+const holderOffset = ref(0);
+const historyOffset = ref(0);
+const nftOffset = ref(0);
+const summary = useCashTokensQuery(tokenSummary, `/v1/tokens/${category}`);
+const holders = useCashTokensQuery(tokenHolders, () => `/v1/tokens/${category}/holders?limit=${pageSize + 1}&offset=${holderOffset.value}`);
+const history = useCashTokensQuery(tokenHistory, () => `/v1/tokens/${category}/transactions?limit=${pageSize + 1}&offset=${historyOffset.value}`);
+const nfts = useCashTokensQuery(tokenOutputs, () => `/v1/tokens/${category}/utxos?nft=true&limit=${pageSize + 1}&offset=${nftOffset.value}`);
+const metadata = computed(() => state.network === "mainnet" ? registry.getTokenIdentity(category) : undefined);
+const info = computed(() => {
+	const value = summary.data.value;
+	if (!value) return [];
+	return [
+		{ title: "Genesis Transaction", text: value.genesis_txid, url: `/tx/${value.genesis_txid}`, copy: true, warp: true },
+		{ title: "Genesis Block", text: value.genesis_height, url: `/block/${value.genesis_height}` },
+		{ title: "Confirmed Supply (base units)", text: exactTokenAmount(value.fungible_supply) },
+		{ title: "NFT Outputs", text: value.nft_count },
+		{ title: "Minting Authorities", text: value.minting_count },
+		{ title: "Token UTXOs", text: value.utxo_count },
+	];
+});
+const holderRows = computed(() => (holders.data.value ?? []).slice(0, pageSize).map(value => {
+	const address = formatLockingBytecodeAddress(value.locking_bytecode.slice(2));
+	return [
+		{ text: address || value.locking_bytecode.slice(2), short: true, copy: true, url: address ? `/address/${address}` : undefined },
+		{ text: exactTokenAmount(value.fungible_token_amount) },
+		{ text: value.nft_count },
+	];
+}));
+const historyRows = computed(() => (history.data.value ?? []).slice(0, pageSize).map(value => [
+	{ text: value.transaction.hash.slice(2), short: true, copy: true, url: `/tx/${value.transaction.hash.slice(2)}` },
+	{ text: value.block.height, url: `/block/${value.block.height}` },
+	{ text: exactTokenAmount(value.fungible_delta) },
+	{ text: value.nft_delta },
+]));
+const nftRows = computed(() => (nfts.data.value ?? []).slice(0, pageSize).map(value => [
+	{ text: `${value.transaction_hash.slice(2)}:${value.output_index}`, short: true, copy: true, url: `/tx/${value.transaction_hash.slice(2)}` },
+	{ text: value.nonfungible_token_capability || "" },
+	{ text: value.nonfungible_token_commitment?.slice(2) || "(empty)", copy: Boolean(value.nonfungible_token_commitment?.slice(2)) },
+]));
+
+function refreshAll() {
+	return Promise.all([summary.refresh(), holders.refresh(), history.refresh(), nfts.refresh()]);
+}
+watch(() => state.network, () => { holderOffset.value = 0; historyOffset.value = 0; nftOffset.value = 0; });
+</script>

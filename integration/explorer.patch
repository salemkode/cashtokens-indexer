new file mode 100644
index 0000000000000000000000000000000000000000..0032091974a0e62d8c433d5d6a02062fdce1faae
--- /dev/null
+++ b/src/module/cashTokens.ts
@@ -0,0 +1,126 @@
+import BigNumber from "bignumber.js";
+import { binToHex, hexToBin, sha256 } from "@bitauth/libauth";
+import { Data } from "effect";
+import { z } from "zod";
+
+export class CashTokensError extends Data.TaggedError("CashTokensError")<{
+	message: string;
+	cause?: unknown;
+}> {}
+
+const decimal = z.string().regex(/^(0|[1-9][0-9]*)$/);
+const signedDecimal = z.string().regex(/^-?(0|[1-9][0-9]*)$/);
+const hash = z.string().regex(/^[0-9a-f]{64}$/);
+const bytea = z.string().regex(/^\\x(?:[0-9a-f]{2})*$/);
+export const tokenSummary = z.object({
+	category: hash,
+	genesis_txid: hash,
+	genesis_height: z.number().int().nonnegative(),
+	fungible_supply: decimal,
+	nft_count: z.number().int().nonnegative(),
+	minting_count: z.number().int().nonnegative(),
+	utxo_count: z.number().int().nonnegative(),
+});
+export const tokenHolders = z.array(z.object({
+	locking_bytecode: bytea,
+	fungible_token_amount: decimal,
+	nft_count: z.number().int().nonnegative(),
+}));
+export const tokenHistory = z.array(z.object({
+	block: z.object({ height: z.number().int().nonnegative(), timestamp: z.number().int().nonnegative() }),
+	transaction: z.object({ hash: bytea }),
+	fungible_delta: signedDecimal,
+	nft_delta: z.number().int(),
+}));
+export const tokenOutputs = z.array(z.object({
+	token_category: bytea,
+	fungible_token_amount: decimal,
+	nonfungible_token_capability: z.enum(["none", "mutable", "minting"]).nullable(),
+	nonfungible_token_commitment: bytea.nullable(),
+	locking_bytecode: bytea,
+	transaction_hash: bytea,
+	output_index: z.number().int().nonnegative(),
+}));
+export const scriptTokens = z.array(z.object({
+	category: hash,
+	fungible_token_amount: decimal,
+	nft_count: z.number().int().nonnegative(),
+}));
+export const indexerStatus = z.object({
+	network: z.enum(["mainnet", "chipnet", "regtest"]),
+	confirmed_only: z.literal(true),
+	tip: z.object({ height: z.number().int().nonnegative(), hash }).nullable(),
+});
+
+export function cashTokensBase(network: string, config: {
+	cashTokensApi: string;
+	cashTokensChipnetApi: string;
+}) {
+	const selected = network === "mainnet" ? config.cashTokensApi :
+		network === "chipnet" ? config.cashTokensChipnetApi : undefined;
+	if (!selected) return undefined;
+	const parsed = z.url().refine(value => {
+		const url = new URL(value);
+		return ["http:", "https:"].includes(url.protocol) && !url.username && !url.password && !url.search && !url.hash;
+	}).safeParse(selected);
+	if (!parsed.success) throw new CashTokensError({ message: "The CashTokens API URL is invalid." });
+	return parsed.data.replace(/\/+$/, "");
+}
+
+export function parseTokenResponse<T extends z.ZodType>(schema: T, body: unknown, network: string, confirmedOnly = true) {
+	const response = z.object({
+		network: z.string(), confirmed_only: z.boolean(), data: z.unknown(),
+	}).parse(body);
+	if (response.network !== network) {
+		throw new CashTokensError({ message: `The CashTokens API serves ${response.network}; this page requires ${network}.` });
+	}
+	if (confirmedOnly && !response.confirmed_only) {
+		throw new CashTokensError({ message: "This view requires confirmed token data." });
+	}
+	return schema.parse(response.data);
+}
+
+export function exactTokenAmount(value: string, decimals = 0) {
+	return new BigNumber(value).shiftedBy(-decimals).toFormat();
+}
+
+const scalarInteger = z.union([z.string().regex(/^-?[0-9]+$/), z.number().int()]).transform(String);
+export const bchOutput = z.object({
+	locking_bytecode: bytea,
+	value_satoshis: decimal,
+	token_category: bytea.nullish(),
+	fungible_token_amount: decimal.nullish(),
+	nonfungible_token_capability: z.enum(["none", "mutable", "minting"]).nullish(),
+	nonfungible_token_commitment: bytea.nullish(),
+});
+const blockReference = z.object({ hash: bytea, height: scalarInteger, timestamp: scalarInteger });
+export const bchTransaction = z.object({
+	hash: bytea,
+	is_coinbase: z.boolean(),
+	input_value_satoshis: decimal.nullable(),
+	output_value_satoshis: decimal,
+	inputs: z.array(z.object({ outpoint: bchOutput.nullable() })),
+	outputs: z.array(bchOutput),
+	block_inclusions: z.array(z.object({ block: blockReference })),
+});
+export const bchBlock = blockReference.extend({
+	transaction_count: scalarInteger,
+	input_count: scalarInteger.nullable(),
+	output_count: scalarInteger.nullable(),
+	input_value_satoshis: decimal.nullable(),
+	output_value_satoshis: decimal.nullable(),
+	size_bytes: scalarInteger.nullable(),
+});
+export const bchBlockDetail = bchBlock.extend({ transactions: z.array(z.object({ transaction: bchTransaction })) });
+export const bchBlocks = z.array(bchBlock);
+export const bchTransactions = z.array(bchTransaction);
+export const bchMempool = z.object({
+	name: z.string(), user_agent: z.string(), unconfirmed_transaction_count: z.number().int().nonnegative(),
+	unconfirmed_transactions: z.array(z.object({ validated_at: z.string(), transaction: bchTransaction })),
+});
+export const bchTip = blockReference;
+
+export function bitcoinHeaderHash(raw: string) {
+	const header = z.string().regex(/^[0-9a-fA-F]{160}$/).parse(raw);
+	return binToHex(sha256.hash(sha256.hash(hexToBin(header))).reverse());
+}

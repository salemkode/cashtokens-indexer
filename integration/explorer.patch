+const clients = new Map<string, Promise<ElectrumClient>>();
+const checkpoints = {
+	mainnet: { height: 792773, hash: "000000000000000002fc0cdadaef1857bbd2936d37ea94f80ba3db4a5e8353e8" },
+	chipnet: { height: 115252, hash: "00000000040ba9641ba98a37b2e5ceead38e4e2930ac8f145c8094f94c708727" },
+};
+const expectedGenesis = {
+	mainnet: "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f",
+	chipnet: "000000001dd410c49a788668ce26751718cc797474d3152a5fc073dd44fd9f7b",
+};
 
-await electrum.connect().catch(console.log);
+export async function electrumFor(network: "mainnet" | "chipnet", config: {
+	electrumMainnetUrl: string;
+	electrumChipnetUrl: string;
+}) {
+	const selected = network === "mainnet" ? config.electrumMainnetUrl : config.electrumChipnetUrl;
+	if (!selected) throw new CashTokensError({ message: `No address data provider is configured for ${network}.` });
+	const endpoint = new URL(z.url().parse(selected));
+	if (!["wss:", "ws:"].includes(endpoint.protocol) || endpoint.username || endpoint.password || endpoint.pathname !== "/" || endpoint.search || endpoint.hash) {
+		throw new CashTokensError({ message: "The address provider must be a WebSocket origin without credentials." });
+	}
+	const key = `${network}:${endpoint.href}`;
+	const existing = clients.get(key);
+	if (existing) return existing;
+	const connecting = (async () => {
+		const scheme = endpoint.protocol === "wss:" ? "wss" : "ws";
+		const client = new ElectrumClient("salemkode-explorer", "1.5", endpoint.hostname,
+			Number(endpoint.port || (scheme === "wss" ? "443" : "80")), scheme, 10000);
+		try {
+			await client.connect();
+			const features = z.object({ genesis_hash: z.string() }).parse(await client.request("server.features"));
+			if (features.genesis_hash !== expectedGenesis[network]) {
+				throw new CashTokensError({ message: "The address data provider is on a different network." });
+			}
+			const checkpoint = checkpoints[network];
+			const header = z.string().regex(/^[0-9a-fA-F]{160}$/).parse(await client.request("blockchain.block.header", checkpoint.height));
+			const digest = bitcoinHeaderHash(header);
+			if (digest !== checkpoint.hash) {
+				throw new CashTokensError({ message: "The address data provider failed its Bitcoin Cash network checkpoint." });
+			}
+			return client;
+		} catch (cause) {
+			clients.delete(key);
+			await client.disconnect().catch(() => undefined);
+			if (cause instanceof CashTokensError) throw cause;
+			throw new CashTokensError({ message: "Unable to connect to the address data provider.", cause });
+		}
+	})();
+	clients.set(key, connecting);
+	return connecting;
+}

--- /dev/null
+++ b/src/hooks/cashTokens.ts
@@ -0,0 +1,33 @@
+import type { MaybeRefOrGetter } from "vue";
+import { z } from "zod";
+import { cashTokensBase, CashTokensError, parseTokenResponse } from "~/module/cashTokens";
+import { useStateStore } from "~/store";
+
+export function useCashTokensQuery<T extends z.ZodType>(schema: T, path: MaybeRefOrGetter<string>) {
+	const config = useRuntimeConfig();
+	const state = useStateStore();
+	const endpoint = computed(() => cashTokensBase(state.network, config.public));
+	const key = computed(() => `cashTokens:${state.network}:${endpoint.value}:${toValue(path)}`);
+	return useAsyncData(key, async () => {
+		const queryNetwork = state.network;
+		if (!endpoint.value) {
+			throw new CashTokensError({ message: `No CashTokens API is configured for ${state.network}.` });
+		}
+		try {
+			const body = await $fetch<unknown>(`${endpoint.value}${toValue(path)}`, { timeout: 10000, retry: 0 });
+			return parseTokenResponse(schema, body, queryNetwork, !toValue(path).startsWith("/v1/bch/"));
+		} catch (cause) {
+			if (cause instanceof CashTokensError) throw cause;
+			throw new CashTokensError({ message: "Unable to load data from the explorer API.", cause });
+		}
+	});
+}
+
+export function useExplorerPolling(refresh: () => Promise<unknown>, interval = 15000) {
+	const polling = { stop() {} };
+	onMounted(() => {
+		const timer = setInterval(() => { refresh(); }, interval);
+		polling.stop = () => clearInterval(timer);
+	});
+	onScopeDispose(() => polling.stop());
+}

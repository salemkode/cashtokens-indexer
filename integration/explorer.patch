diff --git a/test/cashTokens.test.mjs b/test/cashTokens.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a347afc9ab3223ec9ca2c733a73484c0e89b3a0b
--- /dev/null
+++ b/test/cashTokens.test.mjs
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  cashTokensBase, CashTokensError, exactTokenAmount, parseTokenResponse,
+  scriptTokens, tokenSummary, bchBlocks, bchTransaction, bitcoinHeaderHash,
+} from '../src/module/cashTokens.ts';
+
+const category = 'a'.repeat(64);
+
+test('provider selection isolates mainnet and chipnet and rejects embedded credentials', () => {
+  const config = { cashTokensApi: 'https://tokens.example/mainnet/', cashTokensChipnetApi: '' };
+  assert.equal(cashTokensBase('mainnet', config), 'https://tokens.example/mainnet');
+  assert.equal(cashTokensBase('chipnet', config), undefined);
+  assert.equal(cashTokensBase('regtest', config), undefined);
+  assert.throws(() => cashTokensBase('mainnet', { ...config, cashTokensApi: 'https://user:secret@tokens.example' }), CashTokensError);
+  assert.throws(() => cashTokensBase('mainnet', { ...config, cashTokensApi: 'ftp://tokens.example' }), CashTokensError);
+});
+
+test('boundary checks network and exact string token amounts without Number coercion', () => {
+  const response = { network: 'mainnet', confirmed_only: true, data: {
+    category, genesis_txid: 'b'.repeat(64), genesis_height: 792773,
+    fungible_supply: '9223372036854775807', nft_count: 3, minting_count: 1, utxo_count: 5,
+  } };
+  const summary = parseTokenResponse(tokenSummary, response, 'mainnet');
+  assert.equal(summary.fungible_supply, '9223372036854775807');
+  assert.throws(() => parseTokenResponse(tokenSummary, { ...response, confirmed_only: false }, 'mainnet'), /confirmed token data/);
+  assert.throws(() => parseTokenResponse(tokenSummary, response, 'chipnet'), /requires chipnet/);
+  assert.throws(() => parseTokenResponse(tokenSummary, { ...response, data: { ...response.data, fungible_supply: 9007199254740992 } }, 'mainnet'));
+  assert.equal(exactTokenAmount(summary.fungible_supply), '9,223,372,036,854,775,807');
+  assert.equal(exactTokenAmount(summary.fungible_supply, 9), '9,223,372,036.854775807');
+  assert.equal(exactTokenAmount('-9007199254740993'), '-9,007,199,254,740,993');
+});
+
+test('script balances preserve fungibles in NFT UTXOs and reject fractional base amounts', () => {
+  const balances = [{ category, fungible_token_amount: '9007199254740993', nft_count: 2 }];
+  assert.deepEqual(parseTokenResponse(scriptTokens, { network: 'mainnet', confirmed_only: true, data: balances }, 'mainnet'), balances);
+  assert.equal(scriptTokens.safeParse([{ ...balances[0], fungible_token_amount: '1.5' }]).success, false);
+});
+
+test('BCH schemas preserve unknown aggregates and distinguish mempool from block inclusion', () => {
+  const block = { hash: `\\x${category}`, height: 900000, timestamp: 1700000000, transaction_count: 2,
+    input_count: null, output_count: null, input_value_satoshis: null, output_value_satoshis: null, size_bytes: null };
+  const parsed = bchBlocks.parse([block]);
+  assert.equal(parsed[0].height, '900000');
+  assert.equal(parsed[0].size_bytes, null);
+  const transaction = { hash: `\\x${category}`, is_coinbase: false, input_value_satoshis: null,
+    output_value_satoshis: '1000', inputs: [{ outpoint: null }], outputs: [], block_inclusions: [] };
+  assert.equal(bchTransaction.parse(transaction).block_inclusions.length, 0);
+  assert.equal(parseTokenResponse(bchTransaction, { network: 'mainnet', confirmed_only: false, data: transaction }, 'mainnet', false).input_value_satoshis, null);
+});
+
+test('Electrum checkpoint hashes use the consensus double-SHA256 header byte order', () => {
+  const genesisHeader = '01000000' + '00'.repeat(32) +
+    '3ba3edfd7a7b12b27ac72c3e67768f617fc81bc3888a51323a9fb8aa4b1e5e4a' +
+    '29ab5f49ffff001d1dac2b7c';
+  assert.equal(bitcoinHeaderHash(genesisHeader), '000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f');
+  assert.equal(bitcoinHeaderHash(genesisHeader.toUpperCase()), bitcoinHeaderHash(genesisHeader));
+  assert.throws(() => bitcoinHeaderHash('00'.repeat(79)));
+});

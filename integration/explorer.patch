+    </div>
+    <div v-if="summary.error.value" role="alert" class="rounded-2xl border border-rose-200 dark:border-rose-900 bg-white dark:bg-zinc-900 p-5 text-sm text-rose-600 dark:text-rose-400">
+      {{ summary.error.value.message }}
+    </div>
+    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
+      <div class="lg:col-span-4 space-y-6">
+        <ContentWarp :items="info" :loading="summary.status.value === 'pending'" />
+        <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-slate-200/80 dark:border-zinc-800 p-5 space-y-3 text-sm shadow-xs">
+          <h3 class="font-bold text-slate-900 dark:text-white">Token metadata</h3>
+          <template v-if="metadata">
+            <BcmrInfo :identity-snapshot="metadata.identity" :loading="false" />
+            <p class="text-xs text-slate-500 dark:text-zinc-400 break-all">
+              Public registry:
+              <a :href="metadata.url" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline">{{ metadata.url }}</a>
+            </p>
+            <p class="text-xs text-slate-500 dark:text-zinc-400">Registry metadata has not been verified against an on-chain authchain.</p>
+          </template>
+          <p v-else class="text-slate-500 dark:text-zinc-400">{{ registry.loadingProviders ? 'Loading public registries…' : 'No public registry metadata is available for this category.' }}</p>
+        </div>
+      </div>
+      <div class="lg:col-span-8 space-y-6">
+        <TableView title="Token Holders" :rows="holderRows" :columns="['address', 'amount', 'NFTs']" :loading="holders.status.value === 'pending'" :error="holders.error.value?.message" :has-prev-page="holderOffset > 0" :has-next-page="holders.data.value?.length === pageSize + 1" @next="holderOffset += pageSize" @previous="holderOffset -= pageSize" />
+        <p v-if="holders.status.value === 'success' && !holderRows.length" class="text-sm text-slate-500 dark:text-zinc-400">No confirmed token holders.</p>
+        <TableView title="Token Transactions" :rows="historyRows" :columns="['txid', 'block_height', 'token_change', 'NFT change']" :loading="history.status.value === 'pending'" :error="history.error.value?.message" :has-prev-page="historyOffset > 0" :has-next-page="history.data.value?.length === pageSize + 1" @next="historyOffset += pageSize" @previous="historyOffset -= pageSize" />
+        <TableView title="NFT Outputs" :rows="nftRows" :columns="['txid', 'capability', 'commitment']" :loading="nfts.status.value === 'pending'" :error="nfts.error.value?.message" :has-prev-page="nftOffset > 0" :has-next-page="nfts.data.value?.length === pageSize + 1" @next="nftOffset += pageSize" @previous="nftOffset -= pageSize" />
+        <p v-if="nfts.status.value === 'success' && !nftRows.length" class="text-sm text-slate-500 dark:text-zinc-400">No confirmed NFT outputs.</p>
+      </div>
+    </div>
+  </div>
+</template>
